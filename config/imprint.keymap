#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20 // default is 10
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    macros {
        shift_layer: shift_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 3 &kp LSHFT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 3 &kp LSHFT>;
        };

        rshift_layer: rshift_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 4 &kp RSHFT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 4 &kp RSHFT>;
        };

        ctrl_layer: ctrl_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 5 &kp LCTRL>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 5 &kp LCTRL>;
        };

        rctrl_layer: rctrl_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 6 &kp RCTRL>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 6 &kp RCTRL>;
        };

        d_alt: d_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7 &kp LALT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 7 &kp LALT>;
        };

        f_ctrl: f_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7 &kp LCTRL>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 7 &kp LCTRL>;
        };

        f_shift: f_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7 &kp LSHFT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 7 &kp LSHFT>;
        };

        k_alt: k_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 8 &kp RALT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 8 &kp RALT>;
        };

        j_ctrl: j_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 8 &kp RCTRL>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 8 &kp RCTRL>;
        };

        j_shift: j_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 8 &kp RSHFT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 8 &kp RSHFT>;
        };
    };

    behaviors {
        td_lshift: td_lshift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&shift_layer>, <&caps_word>;
        };

        td_rshift: td_rshift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&rshift_layer>, <&caps_word>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // H + J + , → activate right trackball scroll layer
        right_tb_scroll {
            timeout-ms = <50>;
            key-positions = <42 43 56>;  // RGUI, H, J positions
            bindings = <&mo 9>;
        };

        // C + F + G → activate left trackball cursor layer
        left_tb_cursor {
            timeout-ms = <50>;
            key-positions = <51 40 41>;  // RCLK, D, F positions
            bindings = <&mo 10>;
        };
    };

    scroll_scaler: scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };    

    keymap {
        compatible = "zmk,keymap";

        // layer 0
        default_layer {
            bindings = <
&kp F1     &kp F2   &kp F3   &kp F4       &kp F5      &kp F6       &kp F7     &kp F8       &kp F9        &kp F10   &kp F11   &kp F12
&kp EQUAL  &kp N1   &kp N2   &kp N3       &kp N4      &kp N5       &kp N6     &kp N7       &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q    &kp W    &kp E        &kp R       &kp T        &kp Y      &kp U        &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A    &kp S    &kp D        &kp F       &kp G        &kp H      &kp J        &kp K         &kp L     &kp SEMI  &kp SQT
&kp GRAVE  &kp Z    &kp X    &kp C        &kp V       &kp B        &kp N      &kp M        &kp COMMA     &kp DOT   &kp FSLH  &kp DEL
&mo 1      &kp HOME &kp END  &kp LEFT     &kp RIGHT                           &kp DOWN     &kp UP        &kp LBKT  &kp RBKT  &mo 2
                             &kp BSPC     &mkp LCLK   &mkp RCLK    &kp RGUI   &kp RET      &kp SPACE
                             &td_lshift   &ctrl_layer &kp LALT     &kp RALT   &rctrl_layer &td_rshift
            >;
        };

        // layer 1
        Second_Layer {
            bindings = <
&trans  &trans  &trans  &trans   &trans     &trans           &trans           &trans         &trans         &trans         &trans          &trans
&trans  &trans  &trans  &trans   &trans     &trans           &kp LA(LS(N7))   &kp LA(LS(N6)) &kp LA(LS(N8)) &kp LA(LS(N0)) &kp LA(LS(DOT)) &kp LA(LS(COMMA))
&trans  &trans  &trans  &trans   &trans     &trans           &trans           &kp HOME       &kp END        &kp PSCRN      &trans          &trans
&trans  &trans  &trans  &trans   &trans     &trans           &trans           &kp INS        &kp PG_UP      &kp PG_DN      &trans          &trans
&trans  &trans  &trans  &trans   &trans     &trans           &trans           &trans         &trans         &trans         &trans          &trans
&trans  &trans  &trans  &trans   &trans                                       &msc SCRL_DOWN &msc SCRL_UP   &trans         &trans          &trans
                        &kp DEL  &mkp MCLK  &kp CAPS         &trans           &trans         &trans
                        &mkp MB4 &mkp MB5   &out OUT_TOG     &trans           &trans         &trans
            >;
        };

        // layer 2
        Keyboard_Control_Layer {
            bindings = <
&trans     &trans       &trans       &trans         &trans          &trans           &trans          &trans           &trans           &trans           &trans           &trans
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4     &trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans           &trans           &trans
&trans     &trans       &trans       &trans         &trans          &trans           &rgb_ug RGB_TOG &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &sys_reset
&trans     &trans       &trans       &trans         &trans          &trans           &trans          &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &bootloader
&trans     &trans       &trans       &trans         &trans          &trans           &trans          &trans           &trans           &trans           &trans           &trans
&trans     &trans       &trans       &msc SCRL_LEFT &msc SCRL_RIGHT                                  &trans           &trans           &trans           &trans           &trans
                                     &trans         &trans          &trans           &trans          &trans           &trans
                                     &trans         &trans          &trans           &trans          &trans           &trans
            >;
        };

        // layer 3
        Left_Shift_Layer {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &d_alt   &f_ctrl  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans                        &trans  &trans  &trans  &trans  &trans
                        &trans   &trans   &trans       &trans  &trans  &trans
                        &trans   &trans   &trans       &trans  &trans  &trans
            >;
        };

        // layer 4
        Right_Shift_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &j_ctrl &k_alt  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans       &trans  &trans  &trans
                        &trans  &trans  &trans       &trans  &trans  &trans
            >;
        };

        // layer 5
        Left_Ctrl_Layer {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &d_alt   &f_shift &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans                        &trans  &trans  &trans  &trans  &trans
                        &trans   &trans   &trans       &trans  &trans  &trans
                        &trans   &trans   &trans       &trans  &trans  &trans
            >;
        };

        // layer 6
        Right_Ctrl_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &j_shift &k_alt   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans   &trans   &trans  &trans  &trans
                        &trans  &trans  &trans       &trans  &trans   &trans
                        &trans  &trans  &trans       &trans  &trans   &trans
            >;
        };

        // layer 7
        Left_Restricted_Layer {
            bindings = <
&none  &none  &none  &none  &none  &none       &none     &none    &none     &none  &none  &none
&none  &none  &none  &none  &none  &none       &none     &none    &none     &none  &none  &none
&none  &none  &none  &none  &none  &none       &none     &none    &none     &none  &none  &none
&none  &none  &none  &none  &none  &none       &none     &none    &none     &none  &none  &none
&none  &none  &none  &none  &none  &none       &none     &none    &none     &none  &none  &none
&none  &none  &none  &none  &none                        &none    &none     &none  &none  &none
                     &none  &none  &none       &kp RGUI  &kp RET  &kp SPACE
                     &none  &none  &none       &none     &none    &none
            >;
        };

        // layer 8
        Right_Restricted_Layer {
            bindings = <
&none  &none  &none  &none    &none &none       &none  &none  &none  &none  &none  &none
&none  &none  &none  &none    &none &none       &none  &none  &none  &none  &none  &none
&none  &none  &none  &none    &none &none       &none  &none  &none  &none  &none  &none
&none  &none  &none  &none    &none &none       &none  &none  &none  &none  &none  &none
&none  &none  &none  &none    &none &none       &none  &none  &none  &none  &none  &none
&none  &none  &none  &none    &none                    &none  &none  &none  &none  &none
                     &kp BSPC &none &none       &none  &none  &none
                     &none    &none &none       &none  &none  &none
            >;
        };

        // layer 9
        Right_TB_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans     &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans     &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans     &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans     &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans     &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &trans     &trans    &trans  &trans  &trans
                        &trans  &trans  &trans       &mkp LCLK  &mkp RCLK  &mkp MCLK
                        &trans  &trans  &trans       &trans     &trans     &trans
            >;
        };

        // layer 10
        Left_TB_Cursor {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans                          &trans  &trans  &trans  &trans  &trans
                        &mkp MCLK  &mkp LCLK  &mkp RCLK    &trans  &trans  &trans
                        &trans     &trans     &trans       &trans  &trans  &trans
            >;
        };
    };
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE DOT>;
};

&msc {
    acceleration-exponent = <1>;   // 0 = constant speed, 1 = linear accel, 2 = quadratic
    time-to-max-speed-ms = <150>;  // how fast it ramps up
    delay-ms = <0>;                // delay before movement starts
};

// right hand trackball configuration

&trackball_peripheral_listener {
    input-processors =
        // reduce mouse sensitivity
        <&zip_xy_scaler 1 2>;

    scroll_mode {
        layers = <9>;
        input-processors =
            <&zip_xy_scaler 1 2>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };
};

//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),
        <&zip_xy_scaler 1 2>,
        // make this trackball output scrolling events by default instead of cursor movement,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;

    cursor_mode {
        layers = <10>;
        input-processors =
            <&zip_xy_scaler 1 2>;
    };
};
